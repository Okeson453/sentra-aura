{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PublicationPublished",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "channel_id",
    "publication_id",
    "asset_id",
    "platform"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "publication.published"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "channel_id": {
      "type": "string"
    },
    "publication_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "youtube",
        "tiktok",
        "instagram",
        "twitter"
      ]
    },
    "platform_video_id": {
      "type": "string"
    },
    "published_url": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "disclosure_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}