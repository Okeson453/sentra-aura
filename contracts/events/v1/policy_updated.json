{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolicyUpdated",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "channel_id",
    "policy_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "policy.updated"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "channel_id": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "previous_version": {
      "type": "string"
    },
    "new_version": {
      "type": "string"
    },
    "change_reason": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "weights_delta": {
      "type": "object"
    }
  }
}