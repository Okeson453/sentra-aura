{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrendDetected",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "channel_id",
    "topic_id",
    "trend_signal"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "trend.detected"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "channel_id": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "trend_signal": {
      "type": "object",
      "required": [
        "signal_id",
        "source",
        "demand_score",
        "competition_score",
        "freshness_score",
        "monetization_score",
        "risk_score"
      ],
      "properties": {
        "signal_id": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "youtube_trends",
            "google_trends",
            "rss_news",
            "social_listening",
            "competitor_analysis"
          ]
        },
        "query": {
          "type": "string"
        },
        "demand_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "competition_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "freshness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "monetization_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "raw_data": {
          "type": "object"
        }
      }
    }
  }
}