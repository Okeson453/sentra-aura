# Analytics Ingestion Service
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=analytics-ingestion
HOST=0.0.0.0
PORT=8000
METRICS_PORT=9090
DATABASE_URL=postgresql+asyncpg://sentra:sentra@localhost:5432/analytics_ingestion
REDIS_URL=redis://localhost:6379/4
YOUTUBE_API_KEY=your_youtube_api_key
WAREHOUSE_URL=clickhouse://localhost:8123/analytics
NATS_URL=nats://localhost:4222

# Security
# Analytics data is tenant-sensitive and this service also spends provider
# quota, so authentication is enforced at the application boundary. Production
# refuses the default below and requires a strong, unique secret.
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
# Fail-closed by default; set to false only for a deliberately open surface.
REQUIRE_AUTH=true
# Derive the acting tenant from the verified JWT claim only.
ENFORCE_TENANT_ISOLATION=true

# YouTube Data API budget for real request accounting (videos.list = 1 unit).
YOUTUBE_DAILY_QUOTA_UNITS=10000
