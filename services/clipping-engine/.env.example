# SentraAura Clipping Engine Environment Configuration
# Copy to .env and fill in real values

# Service
CLIPPING_ENGINE_LOG_LEVEL=INFO
CLIPPING_ENGINE_PORT=8080

# Observability
CLIPPING_ENGINE_OTEL_ENDPOINT=http://otel-collector:4317

# Database
CLIPPING_ENGINE_DATABASE_URL=sqlite:///./clipping_engine.db

# Cache
CLIPPING_ENGINE_REDIS_URL=redis://redis:6379/0

# Security
CLIPPING_ENGINE_JWT_SECRET=change-me-in-production
CLIPPING_ENGINE_API_KEY_HEADER=X-API-Key

# Limits
CLIPPING_ENGINE_MAX_REQUEST_SIZE_MB=50
CLIPPING_ENGINE_REQUEST_TIMEOUT_SECONDS=30
