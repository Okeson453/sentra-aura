# SentraAura Rights Registry Service Environment Configuration
# Copy to .env and fill in real values

# Service
RIGHTS_REGISTRY_SERVICE_LOG_LEVEL=INFO
RIGHTS_REGISTRY_SERVICE_PORT=8080

# Observability
RIGHTS_REGISTRY_SERVICE_OTEL_ENDPOINT=http://otel-collector:4317

# Database
RIGHTS_REGISTRY_SERVICE_DATABASE_URL=sqlite:///./rights_registry.db

# Cache
RIGHTS_REGISTRY_SERVICE_REDIS_URL=redis://redis:6379/0

# Security
RIGHTS_REGISTRY_SERVICE_JWT_SECRET=change-me-in-production
RIGHTS_REGISTRY_SERVICE_API_KEY_HEADER=X-API-Key

# Limits
RIGHTS_REGISTRY_SERVICE_MAX_REQUEST_SIZE_MB=50
RIGHTS_REGISTRY_SERVICE_REQUEST_TIMEOUT_SECONDS=30
