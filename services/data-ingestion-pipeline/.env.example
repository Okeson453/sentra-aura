# data-ingestion-pipeline Environment Configuration
# Copy to .env and fill in production values

# Service identity
ENVIRONMENT=development
SERVICE_NAME=data-ingestion-pipeline
SERVICE_VERSION=0.1.0

# HTTP server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=postgresql+psycopg2://sentraaura:sentraaura@localhost:5432/sentraaura
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Message bus
NATS_URL=nats://localhost:4222
NATS_MAX_RECONNECT=10

# Workflow engine
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=sentraaura
TEMPORAL_TASK_QUEUE=sentraaura-tasks

# Security
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
API_KEY_HEADER=X-API-Key
ALLOWED_TENANTS=tenant1,tenant2

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
HEALTH_CHECK_TIMEOUT_SECONDS=5

# CORS
CORS_ORIGINS=http://localhost:3000,https://sentraaura.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Tenant-ID,X-Channel-ID

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY_SECONDS=60.0

# Cost control
MAX_BUDGET_USD_PER_TASK=10.0
COST_ALERT_THRESHOLD_USD=100.0

# Feature flags
FEATURE_FLAGS=enable_clipping=true,enable_multichannel=false

# Data ingestion specific
INGESTION_BATCH_SIZE=100
INGESTION_POLL_INTERVAL_SECONDS=300
MAX_INGESTION_JOBS=10
YOUTUBE_API_KEY=
GOOGLE_TRENDS_API_KEY=
RSS_FEED_URLS=https://example.com/feed1,https://example.com/feed2
SOCIAL_LISTENING_KEYWORDS=AI,technology,media
COLLECTOR_TIMEOUT_SECONDS=30
NORMALIZER_TIMEOUT_SECONDS=10

