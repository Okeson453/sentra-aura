# SentraAura Publishing Service Environment Configuration
# Copy to .env and fill in real values

# Service
PUBLISHING_SERVICE_LOG_LEVEL=INFO
PUBLISHING_SERVICE_PORT=8080

# Observability
PUBLISHING_SERVICE_OTEL_ENDPOINT=http://otel-collector:4317

# Database
PUBLISHING_SERVICE_DATABASE_URL=sqlite:///./publishing_service.db

# Cache
PUBLISHING_SERVICE_REDIS_URL=redis://redis:6379/0

# Security
PUBLISHING_SERVICE_JWT_SECRET=change-me-in-production
PUBLISHING_SERVICE_API_KEY_HEADER=X-API-Key

# Limits
PUBLISHING_SERVICE_MAX_REQUEST_SIZE_MB=50
PUBLISHING_SERVICE_REQUEST_TIMEOUT_SECONDS=30
