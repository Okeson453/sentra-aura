# SentraAura Media Renderer Environment Configuration
# Copy to .env and fill in real values

# Service
MEDIA_RENDERER_LOG_LEVEL=INFO
MEDIA_RENDERER_PORT=8080

# Observability
MEDIA_RENDERER_OTEL_ENDPOINT=http://otel-collector:4317

# Database
MEDIA_RENDERER_DATABASE_URL=sqlite:///./media_renderer.db

# Cache
MEDIA_RENDERER_REDIS_URL=redis://redis:6379/0

# Security
MEDIA_RENDERER_JWT_SECRET=change-me-in-production
MEDIA_RENDERER_API_KEY_HEADER=X-API-Key

# Limits
MEDIA_RENDERER_MAX_REQUEST_SIZE_MB=50
MEDIA_RENDERER_REQUEST_TIMEOUT_SECONDS=30
