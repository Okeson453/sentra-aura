# SentraAura Local Development Environment
# No real secrets — local uses mock providers and locally-generated dev credentials only.

ENVIRONMENT=local
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+asyncpg://sentra:sentra@localhost:5432/sentra_aura
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0

# NATS JetStream
NATS_URL=nats://localhost:4222

# Object Storage (MinIO in local)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sentra-aura-assets

# Vault (dev mode in local)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-token

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Mock Provider Gateway (local dev only)
MOCK_PROVIDER_GATEWAY_URL=http://localhost:8081

# Control Plane
CONTROL_PLANE_API_URL=http://localhost:8000
